# BetterLal-lo local configuration
# Copy this file to .env.local and update values as official information becomes available.

# Government Information
VITE_GOVERNMENT_NAME="Municipality of Lal-lo"
VITE_GOVERNMENT_TYPE="Municipality"
VITE_REGION="Cagayan Valley (Region II)"
VITE_PROVINCE="Cagayan"

# Website Information
VITE_WEBSITE_URL="http://localhost:5173"
VITE_CONTACT_EMAIL=""
VITE_CONTACT_PHONE=""

# Public map/weather configuration. Coordinates are the verified Lal-lo
# Municipal Hall OpenStreetMap feature; no secret is used here.
VITE_LALLO_LATITUDE="18.20015"
VITE_LALLO_LONGITUDE="121.66282"

# Social Media (Optional)
VITE_FACEBOOK_URL=""
VITE_TWITTER_URL=""
VITE_INSTAGRAM_URL=""
VITE_YOUTUBE_URL=""

# SEO
VITE_SITE_DESCRIPTION="A community-run civic information portal for Lal-lo, Cagayan."
VITE_SITE_KEYWORDS="Lal-lo, Cagayan, local government, public services, civic information"
VITE_OG_IMAGE_URL="http://localhost:5173/og-image.jpg"
VITE_TWITTER_HANDLE=""

# Analytics (Optional)
VITE_GOOGLE_ANALYTICS_ID=""
VITE_FACEBOOK_PIXEL_ID=""

# Optional Codex/Jev developer tooling. This is read by the project-scoped
# MCP server from the developer's user environment, not by Vite. Keep the key
# out of .env.local and never expose it through a VITE_ variable.
# TYPESAFE_API_KEY=

# Optional public chat UI. Keep false for static deployments without the
# server-side /api/chat Vercel Function.
VITE_PUBLIC_CHAT_ENABLED="false"

# Server-only Vercel Function settings. Configure these in the Vercel project
# environment, never in browser-facing VITE_ variables. Do not commit the key
# or place it in .env.local.
# TYPESAFE_CHAT_ENABLED="false"
# Enable live approved source adapters (Budget and Statistics are currently
# verified; other registered sources stay unavailable until their contracts are
# reviewed). This flag is server-only and must not be prefixed with VITE_.
# PUBLIC_CHAT_EXTERNAL_SOURCES_ENABLED="false"
# TYPESAFE_MODEL="jev-latest"
# TYPESAFE_API_KEY=
