{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm install",
  "devCommand": "npm run dev -- --host 0.0.0.0 --port $PORT",
  "rewrites": [
    {
      "source": "/((?!api|src|@vite|@react-refresh|@id|node_modules|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
